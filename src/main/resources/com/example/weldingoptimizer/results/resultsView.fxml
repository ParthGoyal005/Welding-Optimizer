<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.weldingoptimizer.results.resultsController">
   <children>
      <Label fx:id="headingLabel" layoutX="340.0" layoutY="12.0" text="Results">
         <font>
            <Font size="28.0" />
         </font>
      </Label>

      <TableView fx:id="resultsTable" layoutX="20.0" layoutY="55.0" prefHeight="380.0" prefWidth="860.0">
         <columns>
            <TableColumn fx:id="wCol" prefWidth="85.0" text="W" />
            <TableColumn fx:id="vCol" prefWidth="70.0" text="V" />
            <TableColumn fx:id="nCol" prefWidth="70.0" text="N" />
            <TableColumn fx:id="sCol" prefWidth="85.0" text="S" />
            <TableColumn fx:id="gCol" prefWidth="70.0" text="G" />
            <TableColumn fx:id="pCol" prefWidth="100.0" text="P pred" />
            <TableColumn fx:id="hCol" prefWidth="90.0" text="h" />
            <TableColumn fx:id="iCol" prefWidth="90.0" text="I" />
            <TableColumn fx:id="heatCol" prefWidth="100.0" text="Heat Input" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>

      <!-- Empty / pending-backend state — same visual language as Expert System "suggest" screens -->
      <Label fx:id="emptyHeading" layoutX="120.0" layoutY="160.0" text="We suggest checking the following" visible="false">
         <font>
            <Font size="27.0" />
         </font>
      </Label>
      <Label fx:id="emptyMessage" layoutX="80.0" layoutY="210.0" prefWidth="740.0" text="" textAlignment="CENTER" wrapText="true" visible="false">
         <font>
            <Font size="18.0" />
         </font>
      </Label>

      <Button layoutX="405.0" layoutY="450.0" mnemonicParsing="false" onAction="#back" style="-fx-background-color: #0468BF; -fx-text-fill: white; -fx-background-radius: 6px; -fx-min-width: 90;" text="Back">
         <font>
            <Font size="14.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
